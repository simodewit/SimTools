<UserControl x:Class="SimTools.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SimTools.Converters"
             xmlns:componentModel="clr-namespace:System.ComponentModel;assembly=WindowsBase">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Themes/Colors.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Themes/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Media grouped by Category -->
            <CollectionViewSource x:Key="mediaByCategory" Source="{Binding Media}">
                <CollectionViewSource.GroupDescriptions>
                    <PropertyGroupDescription PropertyName="Category"/>
                </CollectionViewSource.GroupDescriptions>
            </CollectionViewSource>

            <!-- Races grouped by Month/Year, sorted by date -->
            <conv:MonthYearConverter x:Key="MonthYearConverter"/>
            <CollectionViewSource x:Key="racesByMonth" Source="{Binding UpcomingRaces}">
                <CollectionViewSource.GroupDescriptions>
                    <PropertyGroupDescription PropertyName="DateLocal" Converter="{StaticResource MonthYearConverter}"/>
                </CollectionViewSource.GroupDescriptions>
                <CollectionViewSource.SortDescriptions>
                    <componentModel:SortDescription PropertyName="DateUtc" Direction="Ascending"/>
                </CollectionViewSource.SortDescriptions>
            </CollectionViewSource>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20" Orientation="Vertical">

            <!-- Header Card -->
            <Border Style="{DynamicResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Welcome to SimTools" FontSize="22" FontWeight="Bold"/>
                        <TextBlock Text="Tune your wheel, map your keys, and craft overlays."
                                   Foreground="{DynamicResource Brush.TextDim}"/>
                    </StackPanel>

                    <!-- Equal width AND height -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Discord"
                                Style="{StaticResource PrimaryButton}"
                                Width="110" Height="36"
                                Margin="0,0,8,0"
                                Click="Discord_Click"/>
                        <Button Content="Website"
                                Style="{StaticResource GhostButton}"
                                Width="110" Height="36"
                                Click="Website_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Two columns below the header -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: Upcoming Races -->
                <Border Grid.Column="0" Style="{DynamicResource Card}" Margin="0,0,6,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Upcoming Races" FontWeight="Bold" FontSize="16" Margin="0,0,0,6"/>

                        <!-- Internal scroll; forced to top alignment -->
                        <ScrollViewer x:Name="RacesScroll"
                                      Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalContentAlignment="Top"
                                      Height="520"
                                      Loaded="RacesScroll_Loaded">
                            <ItemsControl ItemsSource="{Binding Source={StaticResource racesByMonth}}"
                                          VerticalAlignment="Top"
                                          SnapsToDevicePixels="True">
                                <ItemsControl.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,4"/>
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ItemsControl.GroupStyle>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,4,0,0" Padding="8"
                                                CornerRadius="8"
                                                Background="{DynamicResource Brush.SurfaceAlt}"
                                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Date pill -->
                                                <Border Grid.Column="0" Margin="0,0,8,0" Padding="8,6"
                                                        CornerRadius="6"
                                                        Background="{DynamicResource Brush.Surface}">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding DateLocal, Mode=OneWay, StringFormat={}{0:dd}}" FontSize="16" FontWeight="Bold"/>
                                                        <TextBlock Text="{Binding DateLocal, Mode=OneWay, StringFormat={}{0:MMM}}" FontSize="11" Foreground="{DynamicResource Brush.TextDim}"/>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Details -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock>
                                                        <Run Text="{Binding Series}" FontWeight="SemiBold"/>
                                                        <Run Text=" — "/>
                                                        <Run Text="{Binding Event}"/>
                                                    </TextBlock>
                                                    <TextBlock Foreground="{DynamicResource Brush.TextDim}" FontSize="12">
                                                        <Run Text="{Binding Circuit}"/>
                                                        <Run Text=", "/>
                                                        <Run Text="{Binding Country}"/>
                                                        <Run Text=" • "/>
                                                        <Run Text="{Binding DateLocal, Mode=OneWay, StringFormat={}{0:ddd HH:mm}}"/>
                                                    </TextBlock>
                                                </StackPanel>

                                                <!-- Action -->
                                                <Button Grid.Column="2"
                                                        Content="Details"
                                                        Style="{StaticResource GhostButton}"
                                                        Tag="{Binding Link}"
                                                        Click="OpenLink_Click"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- RIGHT: Live Motorsport Media -->
                <Border Grid.Column="1" Style="{DynamicResource Card}" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Live Motorsport Media" FontWeight="Bold" FontSize="16" Margin="0,0,0,6"/>

                        <ItemsControl ItemsSource="{Binding Source={StaticResource mediaByCategory}}">
                            <ItemsControl.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,10,0,4"/>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                    <GroupStyle.Panel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel IsItemsHost="True"/>
                                        </ItemsPanelTemplate>
                                    </GroupStyle.Panel>
                                </GroupStyle>
                            </ItemsControl.GroupStyle>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="160" Height="100" Margin="0,6,6,0"
                                            CornerRadius="8"
                                            Background="{DynamicResource Brush.SurfaceAlt}"
                                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                                        <Grid ClipToBounds="True">
                                            <Image Source="{Binding ImageUrl}" Stretch="UniformToFill"/>

                                            <!-- Caption strip -->
                                            <Border Background="#66000000" VerticalAlignment="Bottom">
                                                <StackPanel Margin="6,4,6,4">
                                                    <TextBlock Text="{Binding Title}" Foreground="#F0FFFFFF"
                                                               FontSize="12" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding PubDate, StringFormat={}{0:dd MMM}}"
                                                               Foreground="#CCFFFFFF" FontSize="10"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Full-tile click + subtle hover overlay -->
                                            <Button Tag="{Binding Link}"
                                                    Click="OpenLink_Click"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Cursor="Hand">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Grid>
                                                            <Rectangle x:Name="Hover" Fill="#22000000" Opacity="0" />
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Hover" Property="Opacity" Value="1"/>
                                                            </Trigger>
                                                            <Trigger Property="IsPressed" Value="True">
                                                                <Setter TargetName="Hover" Property="Opacity" Value="0.8"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
